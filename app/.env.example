# 复制为 .env 后填写；不要提交真实密钥。
# 留空的能力会在工作台标记为未配置，不会伪造生成结果。
TARGET_DIR=

# 逗号分隔的额外浏览器来源，格式为协议、主机和端口，不带路径。
CORS_ALLOW_ORIGINS=
# HOST 监听非回环地址时必须设置。默认回环模式可留空。
API_TOKEN=

# 文本写作与问答：完整的 OpenAI-compatible chat/completions URL
SIMPLE_STORY_WRITER_URL=
SIMPLE_STORY_WRITER_API_KEY=
SIMPLE_STORY_WRITER_MODEL=
NLU_URL=
NLU_API_KEY=
NLU_MODEL=

# 必须是支持图片输入的视觉模型；文本端点不能替代 OCR/VL。
IMAGE_ANALYSIS_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# 问答时是否把该页插画一起发给多模态模型（NLU_MODEL 必须支持图片输入；默认关闭，失败时自动回退文本问答）
NLU_VISION=false

# AI 语音识别（OpenAI 兼容的 /audio/transcriptions 接口）；留空则用本地 faster-whisper
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=

# 云端流式语音识别（WebSocket 地址，16kHz/16bit/单声道 PCM）。留空则只用本地识别。
ASR_WS_SERVER_URL=
ASR_TIMEOUT=15

# 火山引擎“录音文件识别大模型”（优先级最高，留空则跳过）
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
VOLC_ASR_TIMEOUT=20

# 保留原有火山方舟视频适配，填实际可用模型。
IMAGE2VIDEO_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE2VIDEO_API_KEY=
IMAGE2VIDEO_MODEL=

# 可选文生图、音乐与音效；PDF 可直接使用原页图。
TEXT2IMAGE_URL=
TEXT2IMAGE_API_KEY=
TEXT2IMAGE_MODEL=
TEXT2MUSIC_URL=
TEXT2MUSIC_API_KEY=
TEXT2MUSIC_MODEL=
TEXT2AUDIO_URL=
TEXT2AUDIO_API_KEY=
TEXT2AUDIO_MODEL=

# 默认不自动下载模型，配置本地目录后启用识别。
WHISPER_MODEL=models/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_ALLOW_DOWNLOAD=false

# 找不到 PATH 工具时填写本机 FFmpeg/ffprobe 可执行文件绝对路径。
FFMPEG_PATH=
FFPROBE_PATH=
BOOK_VIDEO_WIDTH=1280
BOOK_VIDEO_HEIGHT=720
BOOK_VIDEO_FPS=24
BOOK_MAX_PAGES=100
BOOK_MAX_UPLOAD_BYTES=134217728
